        // Localization JS
        script.
            function loadLanguage(lang) {
                // Ensure language is either 'en' or 'ko'
                lang = (lang === 'ko') ? 'ko' : 'en';

                fetch('localization.json')
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! Status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        // Make sure the language exists in our data
                        const strings = data[lang] || {};

                        // Apply translations to elements with matching IDs
                        for (const key in strings) {
                            const el = document.getElementById(key);
                            if (el) {
                                // Handle text content of elements appropriately
                                if (el.tagName === 'A' ||
                                    (el.children.length === 0 &&
                                     !['INPUT', 'TEXTAREA', 'SELECT', 'BUTTON'].includes(el.tagName))) {
                                    el.innerText = strings[key];
                                }
                            }
                        }

                        // Update the document language attribute
                        document.documentElement.lang = lang;

                        // Store user preference
                        localStorage.setItem('preferredLang', lang);

                        // Update all toggle buttons to show the opposite language option
                        const oppositeLang = lang === 'en' ? '한국어' : 'English';

                        // Update desktop toggle button
                        const toggleButton = document.getElementById('langToggle');
                        if (toggleButton) {
                            const toggleSpan = toggleButton.querySelector('span');
                            if (toggleSpan) {
                                toggleSpan.innerText = oppositeLang;
                            }
                        }

                        // Update mobile toggle button
                        const toggleButtonMobile = document.getElementById('langToggleMobile');
                        if (toggleButtonMobile) {
                            const toggleSpanMobile = toggleButtonMobile.querySelector('span');
                            if (toggleSpanMobile) {
                                toggleSpanMobile.innerText = oppositeLang;
                            }
                        }
                    })
                    .catch(error => {
                        console.error('Error loading language file:', error);
                        // Fall back to English if there's an error
                        if (lang !== 'en') {
                            loadLanguage('en');
                        }
                    });
            }

            function toggleLanguage(e) {
                if (e) e.preventDefault();
                const currentLang = document.documentElement.lang || 'en';
                const newLang = currentLang === 'en' ? 'ko' : 'en';
                loadLanguage(newLang);
            }

            document.addEventListener('DOMContentLoaded', () => {
                // Detect user's preferred language
                let userLang = navigator.language || navigator.userLanguage;
                userLang = userLang.toLowerCase();

                // Check localStorage first for returning visitors
                let preferredLang = localStorage.getItem('preferredLang');

                // If no stored preference, determine based on browser language
                if (!preferredLang) {
                    // Check if the browser language is Korean or starts with ko
                    // This handles both 'ko' and 'ko-KR' formats
                    if (userLang === 'ko' || userLang.startsWith('ko-')) {
                        preferredLang = 'ko';
                    } else {
                        preferredLang = 'en'; // Default to English for all other languages
                    }

                    // Store this automatic choice in localStorage
                    localStorage.setItem('preferredLang', preferredLang);
                }

                // Apply the selected language
                loadLanguage(preferredLang);

                // Set up language toggle buttons (both desktop and mobile versions)
                const toggleButton = document.getElementById('langToggle');
                if (toggleButton) {
                    toggleButton.addEventListener('click', toggleLanguage);
                }

                const toggleButtonMobile = document.getElementById('langToggleMobile');
                if (toggleButtonMobile) {
                    toggleButtonMobile.addEventListener('click', toggleLanguage);
                }
            });
