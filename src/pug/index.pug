            .lang-toggle {
                text-transform: none;
                transition: color 0.15s ease-in-out;
                border-left: 0.25rem solid transparent;
            }
            .lang-toggle:hover,
            .lang-toggle:active,
            .lang-toggle:focus {
                color: #fff;
                border-left: 0.25rem solid #bd5d38;
            }
            .lang-toggle i {
                font-size: 0.85rem;
            }
            .lang-toggle-top {
                position: absolute;
                top: 1rem;
                right: 1rem;
                color: rgba(255, 255, 255, 0.7);
                font-size: 0.9rem;
                border-radius: 50px;
                padding: 0.3rem 0.8rem;
                background-color: rgba(0, 0, 0, 0.1);
                transition: all 0.2s ease-in-out;
                text-decoration: none;
            }
            .lang-toggle-top:hover {
                color: #fff;
                background-color: rgba(189, 93, 56, 0.4);
                text-decoration: none;
            }
            .lang-toggle-top i {
                font-size: 0.8rem;
            }
            @media (min-width: 992px) {
                .lang-toggle-top {
                    top: auto;
                    right: 50%;
                    transform: translateX(50%);
                    bottom: 2rem;
                }
            }
            /* Icon alignment styles */
            .list-inline-item {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 0.75rem;
                margin-right: 1rem;
                height: 3rem;
                width: 3rem;
            }
            .list-inline-item .devicon,
            .list-inline-item .iconify {
                font-size: 2rem;
                line-height: 1;
                vertical-align: middle;
            }
            .list-inline.dev-icons {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
            }
            /* Simple left border for work authorization status */
            #status-info {
                border-left: 4px solid #bd7638;
                padding-left: 10px;
                font-weight: 500;
            }
